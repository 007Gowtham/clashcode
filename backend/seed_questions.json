      ],
      "constraints": ["2 <= nums.length <= 10^5", "-30 <= nums[i] <= 30"],
      "hints": ["Build a prefix product array from left and suffix product array from right."],
      "testCases": [
        { "stdin": "4\n1 2 3 4", "expectedOutput": "24 12 8 6", "difficulty": "MEDIUM", "isHidden": false, "order": 1 },
        { "stdin": "5\n-1 1 0 -3 3", "expectedOutput": "0 0 9 0 0", "difficulty": "MEDIUM", "isHidden": true, "order": 2 }
      ],
      "timeLimit": 2000,
      "memoryLimit": 256
    },
