        { "stdin": "9\n-2 1 -3 4 -1 2 1 -5 4", "expectedOutput": "6", "difficulty": "MEDIUM", "isHidden": false, "order": 1 },
        { "stdin": "1\n1", "expectedOutput": "1", "difficulty": "EASY", "isHidden": false, "order": 2 },
        { "stdin": "5\n5 4 -1 7 8", "expectedOutput": "23", "difficulty": "MEDIUM", "isHidden": true, "order": 3 }
      ],
      "timeLimit": 2000,
      "memoryLimit": 256
    },
    {
