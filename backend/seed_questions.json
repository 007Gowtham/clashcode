      "constraints": ["1 <= prices.length <= 10^5", "0 <= prices[i] <= 10^4"],
      "hints": ["Track the minimum price seen so far and update max profit at each step."],
      "testCases": [
        { "stdin": "6\n7 1 5 3 6 4", "expectedOutput": "5", "difficulty": "EASY", "isHidden": false, "order": 1 },
        { "stdin": "5\n7 6 4 3 1", "expectedOutput": "0", "difficulty": "EASY", "isHidden": false, "order": 2 },
        { "stdin": "3\n1 2 3", "expectedOutput": "2", "difficulty": "EASY", "isHidden": true, "order": 3 }
      ],
      "timeLimit": 2000,
      "memoryLimit": 256
    },
    {
