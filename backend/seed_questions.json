        { "stdin": "6\n4 2 0 3 2 5", "expectedOutput": "9", "difficulty": "HARD", "isHidden": false, "order": 2 },
        { "stdin": "4\n3 0 2 0", "expectedOutput": "3", "difficulty": "HARD", "isHidden": true, "order": 3 }
