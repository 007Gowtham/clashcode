FROM ubuntu:22.04

# Avoid timezone/prompt hangs during install
ENV DEBIAN_FRONTEND=noninteractive

# Install all compiled/interpreted languages needed for ClashCode
RUN apt-get update && apt-get install -y \
    python3 \
    nodejs \
    openjdk-17-jdk \
    g++ \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Keep the container alive infinitely so we can efficiently run exec commands into it
CMD ["tail", "-f", "/dev/null"]
